# Documentation only. `make setup` generates .env with random local passwords.
# To configure manually, copy this file to .env and replace every CHANGE_ME value.
WORDPRESS_PORT=8080
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
WP_ADMIN_USER=developer
WP_ADMIN_PASSWORD=CHANGE_ME
WP_ADMIN_EMAIL=developer@example.test
